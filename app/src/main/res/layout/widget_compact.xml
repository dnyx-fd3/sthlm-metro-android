<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_auto" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Ultra-clean Header: Stop title (opens T-Radar) | ↻ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_header_tap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/widget_station_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="T-Centralen"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_updated_at"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="14:20"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_refresh_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_auto"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/widget_accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2–3 Stop Quick Switcher Tabs (any slot can be 📍 Near me or a chosen station!) -->
        <LinearLayout
            android:id="@+id/widget_tabs_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_tab_0"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_active_auto"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Stop 1"
                android:textColor="@color/widget_tab_active_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_tab_1"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_idle_auto"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Stop 2"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_tab_2"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_idle_auto"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Stop 3"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:padding="6dp"
            android:text="Fetching SL…"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:visibility="visible" />

        <!-- Neon Cyber-Cat Empty State -->
        <FrameLayout
            android:id="@+id/widget_cat_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_cat_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_row_auto" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ViewFlipper
                    android:id="@+id/cat_flipper"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:autoStart="true"
                    android:flipInterval="650">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cat_frame_0" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cat_frame_1" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cat_frame_2" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cat_frame_3" />
                </ViewFlipper>

                <TextView
                    android:id="@+id/widget_cat_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="All buses left without you... poke ↻"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/row_0_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignStart="@id/row_0_content"
                android:layout_alignTop="@id/row_0_content"
                android:layout_alignEnd="@id/row_0_content"
                android:layout_alignBottom="@id/row_0_content"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_row_auto" />

            <LinearLayout
                android:id="@+id/row_0_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/row_0_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_red"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:minWidth="32dp"
                    android:paddingStart="6dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="3dp"
                    android:text="14"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/row_0_dest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Mörby centrum"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/row_0_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/widget_accent"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <Chronometer
                    android:id="@+id/row_0_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/widget_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/row_0_eta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="NOW"
                    android:textColor="@color/widget_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/row_1_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignStart="@id/row_1_content"
                android:layout_alignTop="@id/row_1_content"
                android:layout_alignEnd="@id/row_1_content"
                android:layout_alignBottom="@id/row_1_content"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_row_auto" />

            <LinearLayout
                android:id="@+id/row_1_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/row_1_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_red"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:minWidth="32dp"
                    android:paddingStart="6dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="3dp"
                    android:text="14"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/row_1_dest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Mörby centrum"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/row_1_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/widget_accent"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <Chronometer
                    android:id="@+id/row_1_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/widget_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/row_1_eta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="NOW"
                    android:textColor="@color/widget_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
