<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Top Bar: T-RADAR | 3D ↗ | ⚙ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/main_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="T-RADAR"
            android:textColor="@color/cyan_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_open_3d_web"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/chip_radar_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="◎ 3D"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btn_open_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/chip_idle">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <View
                android:id="@+id/settings_update_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/dot_cyan"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Stop Pills: 📍 Near me + 3 Commute Stops -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_near_me"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/chip_idle"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="📍 Near me"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pill_stop_0"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/chip_active"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="140dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="T-Centralen"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pill_stop_1"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/chip_idle"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="140dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Stop 2"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pill_stop_2"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/chip_idle"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="140dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Stop 3"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pill_add_stop"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/chip_idle"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="+"
                android:textColor="@color/cyan_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Nearby Quick-Switcher Chips (shown only when 📍 Near me is active) -->
    <HorizontalScrollView
        android:id="@+id/nearby_strip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/nearby_strip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Active Stop Title + Meta + Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/board_station_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="T-Centralen"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/board_station_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="SL Live"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_board_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/chip_idle"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/cyan_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Clean 1-Word Mode Filter Chips + Direction Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filter_all"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_active"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="All"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_metro"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_idle"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="Metro"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_bus"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_idle"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="Bus"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_pendel"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/chip_idle"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="Pendel"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_dir_toggle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/chip_idle"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⇅"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status / Empty State / Neon Cat inside Board -->
    <LinearLayout
        android:id="@+id/board_state_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/app_card_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/board_state_cat"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/cat_frame_2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/board_state_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Loading…"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/board_state_action"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_primary_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="ALLOW"
            android:textColor="@color/bg_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Live Departures List -->
    <ListView
        android:id="@+id/board_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:scrollbars="none" />

</LinearLayout>
