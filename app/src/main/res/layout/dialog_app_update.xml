<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="T-RADAR UPDATES"
                android:textColor="@color/cyan_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/upd_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Checking GitHub Releases…"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/upd_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/upd_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:text="Installed: v1.3.0"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/upd_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:progressTint="@color/cyan_accent" />

    <TextView
        android:id="@+id/upd_primary_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_save_bg"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="CHECK NOW"
        android:textColor="@color/bg_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/upd_secondary_btn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_secondary_bg"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="OPEN RELEASES IN BROWSER"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
